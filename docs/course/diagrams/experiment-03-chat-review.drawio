<mxfile host="Electron" type="device"><diagram id="experiment-03-draft-review" name="图1 聊天整理与草稿审核"><mxGraphModel dx="1420" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="d1-title" value="图1  聊天整理与草稿审核用例图" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#0F172A;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="65" y="25" width="1000" height="48" as="geometry" /></mxCell><mxCell id="d1-system" value="NoteAgent 系统" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;align=left;verticalAlign=top;spacingTop=18;spacingLeft=20;fontSize=19;fontStyle=1;fontColor=#0F172A;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="1230" height="830" as="geometry" /></mxCell><mxCell id="d1-learner" value="学习者" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeColor=#0F172A;fontSize=16;fontStyle=1;fontColor=#0F172A;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="80" y="455" width="100" height="125" as="geometry" /></mxCell><mxCell id="d1-chat" value="发起聊天&#10;FR-01" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=center;verticalAlign=middle;fontSize=15;fontColor=#0F172A;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="430" y="170" width="230" height="80" as="geometry" /></mxCell><mxCell id="d1-conversation" value="查阅会话&#10;FR-08" style="ellipse;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=2;align=center;verticalAlign=middle;fontSize=15;fontColor=#0F172A;fontFamily=Microsoft YaHei;" vertex="1" parent="1"><mxGeometry x="430" y="310" width="230" height="80" as="geometry" /></mxCell><mxCell id="d1-request" val